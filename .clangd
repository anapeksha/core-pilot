CompileFlags:
  CompilationDatabase: firmware/s3/build-clang
Diagnostics:
  UnusedIncludes: None
---
If:
  PathMatch: .*firmware/s3/(components/.*/test|main/test)/.*\.cpp
CompileFlags:
  CompilationDatabase: firmware/s3/build-tests-clang
---
If:
  PathMatch: .*managed_components/.*
Diagnostics:
  Suppress: "*"
